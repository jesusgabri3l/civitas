---
import TheOverlay from '../overlay/TheOverlay.vue';
import { destinations } from '../data/destinations';
import type { StageId } from '../state/appStore';

interface Props {
  heading: string;
  intro: string;
  state: StageId;
}

const { heading, intro, state } = Astro.props;
---

<main id="main" class="the-stage" data-initial-state={state}>
  <canvas class="the-stage__canvas" aria-hidden="true" data-stage-canvas></canvas>
  <div class="the-stage__content">
    <h1 class="the-stage__title">{heading}</h1>
    <p class="the-stage__intro">{intro}</p>
    <TheOverlay client:load initialState={state} />
    <nav class="the-stage__nav" aria-label="Destinations">
      <a href="/">Globe</a>
      {destinations.map(({ path, name }) => <a href={path}>{name}</a>)}
    </nav>
  </div>
</main>

<script>
  import { startWorldHub } from '../engine/startWorldHub';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-stage-canvas]');
  if (canvas) void startWorldHub(canvas);
</script>
