---
import TheOverlay from '../overlay/TheOverlay.vue';
import { citiesFor, type DestinationId } from '../cities';
import { langFrom, withLang } from '../i18n/lang';
import { ui } from '../i18n/ui';
import type { StageId } from '../state/appStore';

interface Props {
  heading: string;
  intro: string;
  state: StageId;
  /** City whose story chapters are in the slot (prerendered for SEO and deep links). */
  storyCity?: DestinationId;
}

const { heading, intro, state, storyCity } = Astro.props;
const lang = langFrom(Astro.currentLocale);
const text = ui[lang];
// On the globe (and on a city with a story, where the first chapter opens the page) the title and intro stay for search engines
// and screen readers only.
const onGlobe = state === 'globe';
const textHidden = onGlobe || Boolean(storyCity);
---

<main id="main" class="the-stage" data-initial-state={state} data-city={onGlobe ? undefined : state}>
  <canvas class="the-stage__canvas" aria-hidden="true" data-stage-canvas></canvas>
  <div class="the-stage__content">
    <h1 class:list={['the-stage__title', { 'visually-hidden': textHidden }]}>{heading}</h1>
    <p class:list={['the-stage__intro', { 'visually-hidden': textHidden }]}>{intro}</p>
    <TheOverlay client:load initialState={state} {lang} />
    <!-- Out of sight until a keyboard user reaches it. -->
    <nav class="the-stage__nav" aria-label={text.destinations}>
      <a href={withLang(lang, '/')}>{text.globe}</a>
      {citiesFor(lang).map(({ path, name }) => <a href={path}>{name}</a>)}
    </nav>
  </div>
  <div class="the-stage__story" data-story-root data-story-city={storyCity}>
    <slot />
  </div>
</main>

<script>
  import { stageLoaders } from '../engine/stages';
  import type { StageId } from '../state/appStore';

  // Tiny entry: the engine (three) and the stage on screen download in parallel, instead of the stage waiting for the engine to run.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-stage-canvas]');
  if (canvas) {
    const initial = canvas.closest<HTMLElement>('.the-stage')?.dataset.initialState as StageId | undefined;
    void stageLoaders[initial ?? 'globe']?.().catch(() => {});
    void import('../engine/startCivitas').then(({ startCivitas }) => startCivitas(canvas));
  }
</script>
