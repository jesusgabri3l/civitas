---
import TheLayout from '../layouts/TheLayout.astro';
import TheStage from '../components/TheStage.astro';
import { localHome } from '../data/home';
import { langFrom } from '../i18n/lang';

const home = localHome(langFrom(Astro.currentLocale));
---

<TheLayout {...home}>
  <TheStage heading="Civitas" intro={home.intro} state="globe" />
</TheLayout>
