---
import TheLayout from '../layouts/TheLayout.astro';
import TheMonumentStory from '../components/TheMonumentStory.astro';
import TheStage from '../components/TheStage.astro';
import { monumentStories } from '../cities/server';
import { localCity, type City } from '../cities';
import { langFrom } from '../i18n/lang';

interface Props {
  destination: City;
}

// A monument page: the stage of the city and, once its story exists, the chapters prerendered for search engines and deep links
// (the client fetches the same markup on SPA navigation).
const lang = langFrom(Astro.currentLocale);
const destination = localCity(Astro.props.destination, lang);
const story = monumentStories[lang][destination.id];
---

<TheLayout {...destination}>
  <TheStage
    heading={`${destination.name} · ${destination.monument}`}
    intro={destination.intro}
    state={destination.id}
    storyCity={story ? destination.id : undefined}
  >
    {story && <TheMonumentStory {story} />}
  </TheStage>
</TheLayout>
