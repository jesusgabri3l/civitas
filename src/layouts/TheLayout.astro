---
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import fraunces from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import jetbrainsMono from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
// Athens: GFS Didot for titles; Cormorant Garamond is the reading face of every city (docs/ART-DIRECTION.md). Latin and Greek subsets only; unicode-range keeps
// the Greek file from downloading unless a Greek glyph is on the page.
import '@fontsource/gfs-didot/latin-400.css';
import '@fontsource/gfs-didot/greek-400.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import didotLatin from '@fontsource/gfs-didot/files/gfs-didot-latin-400-normal.woff2?url';
import cormorantLatin from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
// Paris: Bodoni Moda italic for titles (Latin only).
import '@fontsource/bodoni-moda/latin-400-italic.css';
import bodoniItalic from '@fontsource/bodoni-moda/files/bodoni-moda-latin-400-italic.woff2?url';
// Rome: Cinzel 500 for titles (Latin only).
import '@fontsource/cinzel/latin-500.css';
import cinzel from '@fontsource/cinzel/files/cinzel-latin-500-normal.woff2?url';
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  path: string;
  /** City page: preloads that city's fonts. */
  id?: string;
  /** Pages that only feed the client (no search listing). */
  noindex?: boolean;
}

const { title, description, ogImage, path, id, noindex = false } = Astro.props;
const cityFontsById: Record<string, string[]> = {
  athens: [didotLatin, cormorantLatin],
  rome: [cinzel, cormorantLatin],
  paris: [bodoniItalic, cormorantLatin],
};
const cityFonts = (id && cityFontsById[id]) || [];
const canonical = new URL(path, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0b0e" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
    {cityFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Civitas" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
