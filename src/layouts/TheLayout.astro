---
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import fraunces from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import jetbrainsMono from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import { citiesFor } from '../cities';
import { fontPreloads } from '../cities/server';
import '../styles/main.scss';
import { cityThemeCss } from '../cities/themeCss';
import { cityJsonLd, websiteJsonLd } from '../cities/jsonLd';
import { localHome } from '../data/home';
import { alternateUrls, langFrom, otherLang } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  ogImageAlt: string;
  path: string;
  /** City page: preloads that city's fonts. */
  id?: string;
  /** Pages that only feed the client (no search listing). */
  noindex?: boolean;
}

const { title, description, ogImage, ogImageAlt, path, id, noindex = false } = Astro.props;
const lang = langFrom(Astro.currentLocale);
const city = citiesFor(lang).find((candidate) => candidate.id === id);
const cityFonts = city ? fontPreloads[city.id] : [];
const themeCss = cityThemeCss(citiesFor(lang));
const home = localHome(lang);
const jsonLd = city ? cityJsonLd(Astro.site!, home, city, lang) : websiteJsonLd(Astro.site!, home, lang);
// Reciprocal hreflang, self-referencing, plus x-default (English). Pages that only feed the client (404) have none.
const alternates = noindex ? [] : alternateUrls(Astro.site!, path);
const ogLocale = { en: 'en_US', es: 'es_ES' };
const canonical = new URL(path, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0b0e" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
    {cityFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={themeCss}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Civitas" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {import.meta.env.PROD && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="7de2e362-1cf8-4c59-bd50-793d75a3b084" data-domains="visitcivitas.com"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skipToContent}</a>
    <slot />
  </body>
</html>

<script>
  import '../i18n/switch';
</script>
